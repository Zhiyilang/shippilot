# Web console port (app.py). The CLI and MCP server read no configuration.
PORT=7860

# Carbon coefficients. Defaults are documented public figures; override for your
# own region and runner class rather than trusting the world average.
SHIPPILOT_CARBON_INTENSITY=383
SHIPPILOT_RUNNER_WATTS=30
SHIPPILOT_PUE=1.2
SHIPPILOT_EMBODIED=6
